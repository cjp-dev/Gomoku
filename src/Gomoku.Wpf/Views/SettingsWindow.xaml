<Window x:Class="Gomoku.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gomoku.App.ViewModels;assembly=Gomoku.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings - Gomoku .NET" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FFFFFF" TextElement.Foreground="#2C3E50" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Padding="20">
        <StackPanel Width="460">
            <!-- Header -->
            <TextBlock Text="Game Configuration" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="#2C3E50"/>

            <!-- 1. Board Size & Rules Variant -->
            <GroupBox Header="Board Size &amp; Rules Variant" Margin="0,0,0,14" Padding="12,10" BorderBrush="#E2E8F0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="BOARD SIZE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <RadioButton Content="15 × 15 (Standard)" GroupName="BoardSizeGroup" IsChecked="{Binding IsSize15x15}" Margin="0,3,0,3"/>
                        <RadioButton Content="19 × 19 (Go board)" GroupName="BoardSizeGroup" IsChecked="{Binding IsSize19x19}" Margin="0,3,0,3"/>
                        <RadioButton Content="20 × 20 (Freestyle)" GroupName="BoardSizeGroup" IsChecked="{Binding IsSize20x20}" Margin="0,3,0,3"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="RULES VARIANT" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <RadioButton Content="Freestyle (5+ wins)" GroupName="VariantGroup" IsChecked="{Binding IsFreestyle}" Margin="0,3,0,3"/>
                        <RadioButton Content="Standard (Exact 5)" GroupName="VariantGroup" IsChecked="{Binding IsExact5}" Margin="0,3,0,3"/>
                        <RadioButton Content="Renju (Forbidden 3x3/4x4)" GroupName="VariantGroup" IsChecked="{Binding IsRenju}" Margin="0,3,0,3"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 2. AI Engine -->
            <GroupBox Header="AI Engine" Margin="0,0,0,14" Padding="12,10" BorderBrush="#E2E8F0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="AI ENGINE: " FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton Content="Carbon AI (Advanced)" GroupName="EngineGroup" IsChecked="{Binding IsCarbonEngine}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Simple AI" GroupName="EngineGroup" IsChecked="{Binding IsSimpleEngine}" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <!-- 3. Computer Thinking Limits (Carbon AI only) -->
            <GroupBox Header="Computer Thinking Limits" Margin="0,0,0,14" Padding="12,10" BorderBrush="#E2E8F0"
                      Visibility="{Binding IsCarbonEngine, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <RadioButton Grid.Row="0" Grid.Column="0" Content="Fixed depth" GroupName="TimeLimitGroup"
                                 IsChecked="{Binding IsFixedDepth}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="14" IsSnapToTickEnabled="True"
                            TickFrequency="1" Value="{Binding SearchDepth}" IsEnabled="{Binding IsFixedDepth}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SearchDepth, StringFormat={}{0} plies}"
                               Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <RadioButton Grid.Row="2" Grid.Column="0" Content="Time per move" GroupName="TimeLimitGroup"
                                 IsChecked="{Binding IsTimePerMove}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="20" IsSnapToTickEnabled="True"
                            TickFrequency="1" Value="{Binding MoveTimeSeconds}" IsEnabled="{Binding IsTimePerMove}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MoveTimeSeconds, StringFormat={}{0} seconds}"
                               Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <RadioButton Grid.Row="4" Grid.Column="0" Content="Time per game" GroupName="TimeLimitGroup"
                                 IsChecked="{Binding IsTimePerGame}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="30" IsSnapToTickEnabled="True"
                            TickFrequency="1" Value="{Binding GameTimeMinutes}" IsEnabled="{Binding IsTimePerGame}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding GameTimeMinutes, StringFormat={}{0} minutes}"
                               Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </GroupBox>

            <!-- 4. Carbon Opening Book & Transposition Table (Carbon AI only) -->
            <GroupBox Header="Carbon Opening Book &amp; Transposition Table" Margin="0,0,0,14" Padding="12,10" BorderBrush="#E2E8F0"
                      Visibility="{Binding IsCarbonEngine, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <CheckBox Content="Enable Carbon Opening Book (67 symmetry patterns)" IsChecked="{Binding UseOpeningBook}" Margin="0,0,0,10"/>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Table Capacity:" VerticalAlignment="Center" Foreground="#64748B"/>
                        <Slider Grid.Column="1" Minimum="{Binding MinTranspositionTablePower}" Maximum="{Binding MaxTranspositionTablePower}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding TranspositionTablePower}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding TranspositionTableEntriesText}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Dialog Actions -->
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}"
                        Padding="12,6" Background="#ECEFF1" Foreground="#546E7A" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"/>

                <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancelClicked" IsCancel="True"
                        Padding="16,6" Margin="8,0,0,0" Background="#ECEFF1" Foreground="#333333"
                        BorderThickness="0" Cursor="Hand"/>

                <Button DockPanel.Dock="Right" Content="Save" Click="OnSaveClicked" IsDefault="True"
                        Padding="18,6" Background="#3498DB" Foreground="#FFFFFF" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
