<UserControl x:Class="Gomoku.Wpf.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Gomoku.App.ViewModels;assembly=Gomoku.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Wood board background brush -->
        <LinearGradientBrush x:Key="WoodBoardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8C99B" Offset="0.0"/>
            <GradientStop Color="#DCB985" Offset="0.5"/>
            <GradientStop Color="#D2A673" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Black Stone Brush -->
        <RadialGradientBrush x:Key="BlackStoneBrush" Center="0.32,0.32" GradientOrigin="0.32,0.32" RadiusX="0.68" RadiusY="0.68">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#202020" Offset="0.5"/>
            <GradientStop Color="#0A0A0A" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- White Stone Brush -->
        <RadialGradientBrush x:Key="WhiteStoneBrush" Center="0.32,0.32" GradientOrigin="0.32,0.32" RadiusX="0.68" RadiusY="0.68">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F0F0F0" Offset="0.55"/>
            <GradientStop Color="#D5D5D5" Offset="1.0"/>
        </RadialGradientBrush>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Border BorderBrush="#7A5229" BorderThickness="12" CornerRadius="4" Background="{StaticResource WoodBoardBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Direction="315" ShadowDepth="6" Opacity="0.4"/>
            </Border.Effect>

            <Grid x:Name="BoardContainer" Width="640" Height="640">
                <!-- Grid lines and star points canvas -->
                <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>

                <!-- Coordinate labels -->
                <Canvas x:Name="LabelsCanvas" IsHitTestVisible="False"/>

                <!-- Interactive Stones and Intersections -->
                <ItemsControl ItemsSource="{Binding Intersections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding Settings.BoardSize.Height}"
                                         Columns="{Binding Settings.BoardSize.Width}"
                                         Margin="30"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:IntersectionViewModel}">
                            <Button Command="{Binding ClickCommand}"
                                    MouseEnter="OnCellMouseEnter"
                                    MouseLeave="OnCellMouseLeave"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <!-- Renju Forbidden Move Marker (X) -->
                                            <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="#D32F2F"
                                                       Visibility="{Binding ShowForbiddenMarker, Converter={StaticResource BoolToVis}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Black Ghost Stone on hover -->
                                            <Ellipse Width="24" Height="24"
                                                     Opacity="0.45"
                                                     Fill="{StaticResource BlackStoneBrush}"
                                                     Visibility="{Binding ShowBlackGhost, Converter={StaticResource BoolToVis}}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- White Ghost Stone on hover -->
                                            <Ellipse Width="24" Height="24"
                                                     Opacity="0.55"
                                                     Fill="{StaticResource WhiteStoneBrush}"
                                                     Visibility="{Binding ShowWhiteGhost, Converter={StaticResource BoolToVis}}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Placed Black Stone -->
                                            <Ellipse Width="27" Height="27"
                                                     Fill="{StaticResource BlackStoneBrush}"
                                                     Visibility="{Binding IsBlack, Converter={StaticResource BoolToVis}}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="315" Opacity="0.5"/>
                                                </Ellipse.Effect>
                                            </Ellipse>

                                            <!-- Placed White Stone -->
                                            <Ellipse Width="27" Height="27"
                                                     Fill="{StaticResource WhiteStoneBrush}"
                                                     Visibility="{Binding IsWhite, Converter={StaticResource BoolToVis}}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="315" Opacity="0.35"/>
                                                </Ellipse.Effect>
                                            </Ellipse>

                                            <!-- Last Move Red Marker -->
                                            <Ellipse Width="7" Height="7"
                                                     Fill="#E74C3C"
                                                     Visibility="{Binding IsLastMove, Converter={StaticResource BoolToVis}}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Winning Line Gold Ring -->
                                            <Ellipse Width="31" Height="31"
                                                     Stroke="#F39C12" StrokeThickness="3"
                                                     Visibility="{Binding IsWinningLine, Converter={StaticResource BoolToVis}}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>

