<Window x:Class="Gomoku.Wpf.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Gomoku.App.Models;assembly=Gomoku.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=models:AboutInfo}"
        Title="About Gomoku .NET" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F8F9FA" TextElement.Foreground="#212529" FontFamily="Segoe UI">
    <Border Padding="24" Width="440">
        <StackPanel HorizontalAlignment="Center">
            <!-- Author Image with Border & Shadow -->
            <Border Width="120" Height="120" CornerRadius="60" BorderBrush="#3498DB" BorderThickness="3" ClipToBounds="True" Margin="0,0,0,16">
                <Image Source="/Images/2026 Claus Pedersen.jpg" Stretch="UniformToFill"/>
            </Border>

            <!-- Title & Subtitle -->
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding Version, StringFormat={}Version {0}}" FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,2,0,12"/>

            <!-- Author & Year -->
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,14" FontSize="14" FontWeight="SemiBold">
                <Run Text="Developed by "/>
                <Run Text="{Binding Author}" Foreground="#2980B9"/>
                <Run Text=" ("/>
                <Run Text="{Binding Year}"/>
                <Run Text=")"/>
            </TextBlock>

            <!-- Description -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="#4A5568"/>
            </Border>

            <!-- Credits -->
            <TextBlock Text="Engine credit: Michał Czardybon (Carbon Gomoku)" FontSize="11.5" FontStyle="Italic" Foreground="#718096" HorizontalAlignment="Center" Margin="0,0,0,18"/>

            <!-- Close Button -->
            <Button Content="Close" IsDefault="True" IsCancel="True" Click="OnCloseClicked" Width="90" Height="30" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>
    </Border>
</Window>

