<Window x:Class="Gomoku.Wpf.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Gomoku.App.Models;assembly=Gomoku.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=models:AboutInfo}"
        Title="About Gomoku .NET" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FFFFFF" TextElement.Foreground="#2C3E50" FontFamily="Segoe UI">
    <Border Padding="20" Width="490">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Author Portrait & Caption -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,16,0">
                <Border Width="110" Height="110" CornerRadius="8" BorderBrush="#3498DB" BorderThickness="2" ClipToBounds="True" Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.12"/>
                    </Border.Effect>
                    <Image Source="/Images/2026 Claus Pedersen.jpg" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="Claus Pedersen" FontWeight="Bold" FontSize="12.5" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                <TextBlock Text="Author &amp; Developer" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Right Column: Title, Details & Actions -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="{Binding Version, StringFormat={}Version {0}}" FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,8"/>

                <TextBlock Margin="0,0,0,10" FontSize="12.5" FontWeight="SemiBold">
                    <Run Text="Developed by "/>
                    <Run Text="{Binding Author}" Foreground="#2980B9"/>
                    <Run Text=" ("/>
                    <Run Text="{Binding Year}"/>
                    <Run Text=")"/>
                </TextBlock>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#4A5568"/>
                </Border>

                <TextBlock Text="Engine credit: Michał Czardybon (Carbon Gomoku)" FontSize="11" FontStyle="Italic" Foreground="#718096" Margin="0,0,0,16"/>

                <Button Content="OK" IsDefault="True" IsCancel="True" Click="OnCloseClicked"
                        Width="85" Height="28" HorizontalAlignment="Right" Background="#3498DB"
                        Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
