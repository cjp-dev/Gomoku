<Window x:Class="Gomoku.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gomoku.App.ViewModels;assembly=Gomoku.App"
        xmlns:views="clr-namespace:Gomoku.Wpf.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Gomoku .NET" Height="780" Width="1050" MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen" Background="#2C3437" TextElement.Foreground="#ECEFF1"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#1E2426" TextElement.Foreground="#ECEFF1" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New Game" Command="{Binding NewGameCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Game..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save Game..." Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClicked" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Stop Search" Command="{Binding CancelSearchCommand}"/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}" InputGestureText="F2"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Gomoku .NET" Command="{Binding OpenAboutCommand}" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Board Area -->
            <Border Grid.Column="0" Background="#232A2D" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <views:BoardView HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Right Sidebar -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Card -->
                <Border Grid.Row="0" Background="#232A2D" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Game Status" FontSize="14" FontWeight="SemiBold" Foreground="#90A4AE" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Side to move: " Foreground="#B0BEC5"/>
                            <TextBlock Text="{Binding SideToMove}" FontWeight="Bold" Foreground="#64B5F6"/>
                            <TextBlock Text="  |  Move: " Foreground="#B0BEC5"/>
                            <TextBlock Text="{Binding MoveCount, StringFormat={}#{0}}" FontWeight="Bold" Foreground="#81C784"/>
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- AI Analysis Card -->
                <Border Grid.Row="1" Background="#232A2D" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AI Engine Analysis" FontSize="14" FontWeight="SemiBold" Foreground="#90A4AE" Margin="0,0,0,8"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Depth:" Foreground="#90A4AE"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Analysis.Depth}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Score:" Foreground="#90A4AE"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Analysis.Score}" FontWeight="SemiBold" Foreground="#FFD54F"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Best Move:" Foreground="#90A4AE"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Analysis.BestMove}" FontWeight="SemiBold" Foreground="#4FC3F7"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Nodes:" Foreground="#90A4AE"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Analysis.Nodes}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Speed:" Foreground="#90A4AE"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Analysis.Speed}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Action Buttons -->
                <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,12">
                    <Button Content="New Game" Command="{Binding NewGameCommand}" Height="34" Margin="0,0,4,0" FontWeight="SemiBold"/>
                    <Button Content="Undo" Command="{Binding UndoCommand}" Height="34" Margin="4,0,0,0"/>
                </UniformGrid>

                <!-- Move History Card -->
                <Border Grid.Row="3" Background="#232A2D" CornerRadius="8" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Move History" FontSize="14" FontWeight="SemiBold" Foreground="#90A4AE" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding MoveHistoryText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     Foreground="#CFD8DC"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#1E2426" TextElement.Foreground="#90A4AE" Padding="8,4">
            <StatusBarItem Content="{Binding StatusText}"/>
            <Separator Background="#37474F"/>
            <StatusBarItem Content="{Binding Settings.BoardSize, StringFormat={}Size: {0}}"/>
            <Separator Background="#37474F"/>
            <StatusBarItem Content="{Binding Settings.Variant, StringFormat={}Rules: {0}}"/>
            <Separator Background="#37474F"/>
            <StatusBarItem Content="{Binding Settings.AiEngine, StringFormat={}AI: {0}}"/>
        </StatusBar>
    </Grid>
</Window>

