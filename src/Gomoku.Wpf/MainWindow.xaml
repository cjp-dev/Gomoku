<Window x:Class="Gomoku.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Gomoku.App.Models;assembly=Gomoku.App"
        xmlns:vm="clr-namespace:Gomoku.App.ViewModels;assembly=Gomoku.App"
        xmlns:views="clr-namespace:Gomoku.Wpf.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Gomoku .NET"
        Height="820" Width="1080" MinHeight="640" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Segoe UI" FontSize="13" TextElement.Foreground="#2C3E50">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="AnalysisLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,14,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#718096" />
        </Style>
        <Style x:Key="AnalysisField" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2C3E50" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewGameCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding ToggleAnalysisCommand}"/>
        <KeyBinding Key="F2" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Key="F1" Command="{Binding OpenAboutCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Top Menu Bar (Standard light theme matching Checkers) -->
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="4,2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New Game" Command="{Binding NewGameCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Game..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save Game..." Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClicked" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Stop Search" Command="{Binding CancelSearchCommand}"/>
            </MenuItem>
            <MenuItem Header="_Game">
                <MenuItem Header="vs _Computer (You play Black)"
                          IsCheckable="True"
                          IsChecked="{Binding IsHumanVsComputer, Mode=OneWay}"
                          Command="{Binding SetGameModeCommand}"
                          CommandParameter="{x:Static models:GameMode.HumanVsAi}"/>
                <MenuItem Header="vs Computer (You play _White)"
                          IsCheckable="True"
                          IsChecked="{Binding IsComputerVsHuman, Mode=OneWay}"
                          Command="{Binding SetGameModeCommand}"
                          CommandParameter="{x:Static models:GameMode.AiVsHuman}"/>
                <MenuItem Header="vs _Human (Two players)"
                          IsCheckable="True"
                          IsChecked="{Binding IsHumanVsHuman, Mode=OneWay}"
                          Command="{Binding SetGameModeCommand}"
                          CommandParameter="{x:Static models:GameMode.HumanVsHuman}"/>
                <Separator/>
                <MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}" InputGestureText="F2"/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Analysis Panel"
                          IsCheckable="True"
                          IsChecked="{Binding IsAnalysisVisible}"
                          Command="{Binding ToggleAnalysisCommand}"
                          InputGestureText="Ctrl+A"/>
                <MenuItem Header="_Sound Effects"
                          IsCheckable="True"
                          IsChecked="{Binding IsSoundOn}"
                          Command="{Binding ToggleSoundCommand}"/>
                <MenuItem Header="_Coordinate Labels"
                          IsCheckable="True"
                          IsChecked="{Binding IsCoordinatesVisible}"
                          Command="{Binding ToggleCoordinatesCommand}"/>
                <MenuItem Header="_Ghost Stone on Hover"
                          IsCheckable="True"
                          IsChecked="{Binding IsGhostStoneOn}"
                          Command="{Binding ToggleGhostStoneCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Rules &amp; Documentation" Click="OnDocsClicked"/>
                <MenuItem Header="_About Gomoku .NET..." Command="{Binding OpenAboutCommand}" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                   TextElement.Foreground="#64748B" Padding="8,4">
            <StatusBarItem Content="{Binding StatusText}"/>
            <Separator Background="#E2E8F0"/>
            <StatusBarItem Content="{Binding Settings.BoardSize, StringFormat={}Size: {0}}"/>
            <Separator Background="#E2E8F0"/>
            <StatusBarItem Content="{Binding Settings.Variant, StringFormat={}Rules: {0}}"/>
            <Separator Background="#E2E8F0"/>
            <StatusBarItem Content="{Binding Settings.AiEngine, StringFormat={}AI: {0}}"/>
        </StatusBar>

        <!-- Main Content Body -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Board Area with Banner -->
            <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Board Mode & Rules Header Banner -->
                <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,6" Background="#FFFFFF" CornerRadius="6" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.08" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RULES: " FontSize="11" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Border Background="#16A085" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock Text="{Binding VariantBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>

                        <TextBlock Text="SIZE: " FontSize="11" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Border Background="#2C3E50" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Settings.BoardSize}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>

                        <TextBlock Text="AI: " FontSize="11" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Border Background="#2980B9" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Settings.AiEngine, StringFormat={}{0} AI}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>

                        <Border Background="#E67E22" CornerRadius="4" Padding="8,3"
                                Visibility="{Binding IsClockVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ClockText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Gomoku Board View -->
                <views:BoardView Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Right Sidebar -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Game Status & Symmetric Dual-Card Scoreboard -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Panel Header -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="GAME STATUS" FontSize="11" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding VariantBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#16A085" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#2C3E50" Margin="0,2,0,4"/>

                        <!-- Thinking Progress Bar -->
                        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,4,0,8" Foreground="#3498DB"
                                     Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}"/>

                        <!-- Symmetric Player Scoreboard (Black & White) -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Black Player Card -->
                            <Border Grid.Column="0" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlackActiveTurn}" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="BorderBrush" Value="#3498DB"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="14" Height="14" Fill="#202020" Stroke="#0A0A0A" StrokeThickness="1" Margin="0,0,6,0"/>
                                        <TextBlock Text="Black" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BlackPlayerLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#3498DB" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding BlackPiecesCount}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock Text="Stones Placed" FontSize="10" Foreground="#718096" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BlackTimeFormatted}" FontSize="11" FontWeight="Bold" Foreground="#E67E22"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Visibility="{Binding IsClockVisible, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- White Player Card -->
                            <Border Grid.Column="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWhiteActiveTurn}" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="BorderBrush" Value="#3498DB"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#CCCCCC" StrokeThickness="1.5" Margin="0,0,6,0"/>
                                        <TextBlock Text="White" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding WhitePlayerLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#3498DB" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding WhitePiecesCount}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock Text="Stones Placed" FontSize="10" Foreground="#718096" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding WhiteTimeFormatted}" FontSize="11" FontWeight="Bold" Foreground="#E67E22"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Visibility="{Binding IsClockVisible, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Action Buttons -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="New" Command="{Binding NewGameCommand}"
                                    Margin="0,0,4,0" Padding="8,6" Background="#3498DB" Foreground="#FFFFFF"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                                    Margin="2,0,2,0" Padding="8,6" Background="#ECEFF1" Foreground="#333333"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                                    Margin="4,0,0,0" Padding="8,6" Background="#ECEFF1" Foreground="#333333"
                                    BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AI Analysis Panel (Toggleable) -->
                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                        BorderBrush="#3498DB" BorderThickness="4,0,0,0"
                        Visibility="{Binding IsAnalysisVisible, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="ANALYSIS" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalysisLabel}" Text="Move:"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalysisField}" Text="{Binding MoveCount, StringFormat={}#{0}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource AnalysisLabel}" Text="Depth:"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource AnalysisField}" Text="{Binding Analysis.Depth}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource AnalysisLabel}" Text="Score:"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource AnalysisField}" Text="{Binding Analysis.Score}" Foreground="#B45309"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource AnalysisLabel}" Text="Best move:"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource AnalysisField}" Text="{Binding Analysis.BestMove}" Foreground="#0284C7"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource AnalysisLabel}" Text="Nodes:"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource AnalysisField}" Text="{Binding Analysis.Nodes}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource AnalysisLabel}" Text="Speed:"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource AnalysisField}" Text="{Binding Analysis.Speed}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource AnalysisLabel}" Text="Time:"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource AnalysisField}" Text="{Binding Analysis.Time}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Move History Panel -->
                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" Padding="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8">
                            <Run Text="MOVE HISTORY ("/><Run Text="{Binding MoveCount}"/><Run Text=" moves)"/>
                        </TextBlock>

                        <ListBox Grid.Row="1" ItemsSource="{Binding MoveTurns}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="{Binding Turn, StringFormat={}{0}.}" FontWeight="Bold" Foreground="#3498DB" Width="28"/>
                                        <TextBlock Text="{Binding Notation}" FontFamily="Segoe UI" FontWeight="Medium" Foreground="#2C3E50"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
