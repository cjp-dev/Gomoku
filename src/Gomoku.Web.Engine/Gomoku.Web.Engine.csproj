<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmPThreadPoolInitialSize>4</WasmPThreadPoolInitialSize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gomoku.App\Gomoku.App.csproj" />
    <ProjectReference Include="..\Gomoku.Core\Gomoku.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Gomoku.Web\Worker\EngineProtocol.cs" Link="Worker\EngineProtocol.cs" />
  </ItemGroup>

</Project>

