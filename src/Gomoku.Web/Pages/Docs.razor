@page "/docs"
@page "/docs/{Slug}"
@implements IAsyncDisposable
@inject BrainDocs Brain
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_chapter is { } chapter ? $"{chapter.Title} – Gomoku .NET Architecture" : "Gomoku .NET Architecture Manual")</PageTitle>

<div class="docs">
    <header class="docs-header">
        <a class="docs-home" href="docs">Gomoku .NET Architecture</a>
        <a class="docs-play" href="">Play Gomoku</a>
    </header>

    <div class="docs-body">
        <nav class="docs-toc" aria-label="Contents">
            <ol>
                <li><a href="docs" aria-current="@Current("")">Front Page (Index)</a></li>
                @foreach (DocsChapter chapter in _chapters)
                {
                    <li>
                        <a href="@BrainDocs.PageRoute(chapter.Slug)" aria-current="@Current(chapter.Slug)">
                            <span class="docs-number">@chapter.Number</span> @chapter.Title
                        </a>
                    </li>
                }
            </ol>
        </nav>

        <main class="docs-content">
            @if (_error is not null)
            {
                <p class="docs-notice" role="alert">@_error</p>
            }

            @if (_page is not null)
            {
                <article class="markdown-body" @ref="_article">@((MarkupString)_page.Html)</article>

                <nav class="docs-pager" aria-label="Previous and next chapter">
                    @if (Neighbour(-1) is { } previous)
                    {
                        <a class="previous" href="@previous.Href">← @previous.Title</a>
                    }
                    @if (Neighbour(1) is { } next)
                    {
                        <a class="next" href="@next.Href">@next.Title →</a>
                    }
                </nav>
            }
            else if (_notFound)
            {
                <h1>Page not found</h1>
                <p>There is no chapter called "@Slug". Go to the <a href="docs">front page</a>.</p>
            }
            else if (_error is null)
            {
                <p>Loading…</p>
            }
        </main>
    </div>
</div>

@code {
    private IReadOnlyList<DocsChapter> _chapters = [];
    private DocsPage? _page;
    private DocsChapter? _chapter;
    private bool _notFound;
    private string? _error;
    private ElementReference _article;
    private IJSObjectReference? _module;
    private bool _pageShown;

    [Parameter]
    public string? Slug { get; set; }

    private string CurrentSlug => Slug ?? "";

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (_page?.Slug == CurrentSlug)
        {
            return;
        }

        _page = null;
        _chapter = null;
        _notFound = false;
        _error = null;
        try
        {
            _chapters = await Brain.GetChaptersAsync();
            _page = await Brain.GetPageAsync(CurrentSlug);
            _notFound = _page is null;
            _chapter = _chapters.FirstOrDefault(chapter => chapter.Slug == CurrentSlug);
            _pageShown = false;
        }
        catch (HttpRequestException)
        {
            _error = "The documentation could not be loaded. Check your connection and reload the page.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_page is null || _pageShown)
        {
            return;
        }

        _pageShown = true;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/docs.js");
            string problem = await _module.InvokeAsync<string>("render", _article, Fragment());
            if (problem.Length > 0)
            {
                _error = $"Some formulas or diagrams could not be shown. {problem}";
                StateHasChanged();
            }
        }
        catch (JSException exception)
        {
            _error = $"Some formulas or diagrams could not be shown. {exception.Message}";
            StateHasChanged();
        }
    }

    private string? Current(string slug) => slug == CurrentSlug ? "page" : null;

    private (string Href, string Title)? Neighbour(int offset)
    {
        int index = CurrentSlug.Length == 0 ? -1 : _chapters.ToList().FindIndex(c => c.Slug == CurrentSlug);
        int target = index + offset;
        if (target == -1 && index >= 0)
        {
            return (BrainDocs.PageRoute(""), "Front Page");
        }
        if (target >= 0 && target < _chapters.Count)
        {
            return (BrainDocs.PageRoute(_chapters[target].Slug), _chapters[target].Title);
        }
        return null;
    }

    private string Fragment()
    {
        int hash = Navigation.Uri.IndexOf('#');
        return hash < 0 ? "" : Navigation.Uri[(hash + 1)..];
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        string path = Navigation.ToBaseRelativePath(e.Location).Split('#')[0];
        if (_module is not null && _page?.Slug == CurrentSlug && path == BrainDocs.PageRoute(CurrentSlug))
        {
            _ = InvokeAsync(async () => await _module.InvokeVoidAsync("scrollTo", Fragment()));
        }
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

