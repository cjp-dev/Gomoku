@page "/"
@using System.ComponentModel
@using CommunityToolkit.Mvvm.Input
@using Gomoku.Core.Models
@using Gomoku.Web.Services
@implements IDisposable
@inject MainViewModel Vm
@inject ShellDialogs Dialogs
@inject IJSRuntime JS

<PageTitle>Gomoku .NET – Play Five in a Row Online</PageTitle>

<ShellLayout Brand="Gomoku" Menus="_menus" Shortcuts="_shortcuts" Inert="@(Dialogs.Current is not null)" OnCommand="() => { }">
    <BoardArea>
        <Board />
    </BoardArea>
    <SidePanels>
        <StatusPanel IsModified="Vm.IsStatusModified"
                     VariantBadge="@Vm.VariantBadgeText"
                     SettingBadge="@(Vm.IsGameSettingVisible ? Vm.SettingsBadgeText : null)"
                     StatusText="@Vm.StatusText"
                     IsThinking="Vm.IsThinking"
                     First="@BlackPlayer"
                     Second="@WhitePlayer"
                     Undo="Vm.UndoCommand" CanUndo="Vm.CanUndo"
                     Redo="Vm.RedoCommand" CanRedo="Vm.CanRedo"
                     MoveNow="@(Vm.IsVsComputer ? Vm.MoveNowCommand : null)" CanMoveNow="Vm.IsThinking" />

        @if (Vm.IsAnalysisVisible)
        {
            <AnalysisPanel Analysis="_analysis" />
        }

        <MoveHistoryPanel Rows="@HistoryRows" />
    </SidePanels>
</ShellLayout>

@code {
    private MenuDefinition[] _menus = [];
    private Dictionary<string, Func<Task>> _shortcuts = [];
    private AnalysisAdapter _analysis = default!;
    private bool _renderPending;

    private bool IsActive(PieceColor color) => Vm.SideToMove == color && !Vm.GameStatus.IsGameOver();

    // Black moves first, so its card comes first.
    private PlayerInfo BlackPlayer => new(
        "Black", "black-dot", Vm.BlackPlayerLabel, Vm.BlackPiecesCount.ToString(), "Stones Placed",
        Vm.IsClockVisible ? Vm.BlackTimeFormatted : null, IsActive(PieceColor.Black));

    private PlayerInfo WhitePlayer => new(
        "White", "white-dot", Vm.WhitePlayerLabel, Vm.WhitePiecesCount.ToString(), "Stones Placed",
        Vm.IsClockVisible ? Vm.WhiteTimeFormatted : null, IsActive(PieceColor.White));

    private IReadOnlyList<MoveHistoryRow> HistoryRows =>
        [.. Vm.MoveTurns.Select(turn =>
            new MoveHistoryRow(turn.Turn, turn.BlackMove, string.IsNullOrEmpty(turn.WhiteMove) ? null : turn.WhiteMove))];

    protected override void OnInitialized()
    {
        _analysis = new AnalysisAdapter(Vm.Analysis);

        _menus =
        [
            new("File",
            [
                new("New Game", Vm.NewGameCommand, "Ctrl+N"),
                new("Open...", Vm.OpenFileCommand, "Ctrl+O"),
                new("Save", Vm.SaveFileCommand, "Ctrl+S"),
                new("Save As...", Vm.SaveFileCommand),
            ]),
            new("Game",
            [
                new("vs Computer (Black)", new AsyncRelayCommand(() => Vm.SetGameModeAsync(GameMode.HumanVsAi)), IsChecked: () => Vm.IsHumanVsComputer, Radio: true),
                new("vs Computer (White)", new AsyncRelayCommand(() => Vm.SetGameModeAsync(GameMode.AiVsHuman)), IsChecked: () => Vm.IsComputerVsHuman, Radio: true),
                new("vs Human (Two players)", new AsyncRelayCommand(() => Vm.SetGameModeAsync(GameMode.HumanVsHuman)), IsChecked: () => Vm.IsHumanVsHuman, Radio: true),
                new("Switch sides", Vm.SwitchSidesCommand, SeparatorBefore: true),
                new("Settings...", Vm.OpenSettingsCommand, "F2", SeparatorBefore: true),
            ]),
            new("Options",
            [
                new("Analysis", Vm.ToggleAnalysisCommand, "Ctrl+A", IsChecked: () => Vm.IsAnalysisVisible),
                new("Sound", Vm.ToggleSoundCommand, IsChecked: () => Vm.IsSoundOn),
                ThemeEntry("Wood Board", "Wood", separatorBefore: true),
                ThemeEntry("Dark Board", "Dark"),
                ThemeEntry("Classic Board", "Classic"),
                new("Coordinates", Vm.ToggleCoordinatesCommand, IsChecked: () => Vm.IsCoordinatesVisible, SeparatorBefore: true),
                new("Ghost Stone", Vm.ToggleGhostStoneCommand, IsChecked: () => Vm.IsGhostStoneOn),
                new("Highlight Last Move", Vm.ToggleLastMoveHighlightCommand, IsChecked: () => Vm.IsLastMoveHighlightOn),
                new("Highlight Winning Line", Vm.ToggleWinLineHighlightCommand, IsChecked: () => Vm.IsWinLineHighlightOn),
            ]),
            new("Help",
            [
                new("User guide", new RelayCommand(OpenUserGuide), "F1"),
                new("Rules & Documentation", new RelayCommand(OpenDocs), "Shift+F1"),
                new("About Gomoku .NET...", Vm.OpenAboutCommand),
            ]),
        ];

        _shortcuts = new()
        {
            ["n"] = () => ShellCommands.RunAsync(Vm.NewGameCommand),
            ["o"] = () => ShellCommands.RunAsync(Vm.OpenFileCommand),
            ["s"] = () => ShellCommands.RunAsync(Vm.SaveFileCommand),
            ["z"] = () => ShellCommands.RunAsync(Vm.UndoCommand),
            ["y"] = () => ShellCommands.RunAsync(Vm.RedoCommand),
            ["m"] = () => ShellCommands.RunAsync(Vm.MoveNowCommand),
            ["a"] = () => ShellCommands.RunAsync(Vm.ToggleAnalysisCommand),
            ["f1"] = () => Run(OpenUserGuide),
            ["shift+f1"] = () => Run(OpenDocs),
            ["f2"] = () => ShellCommands.RunAsync(Vm.OpenSettingsCommand),
        };

        Vm.PropertyChanged += OnChanged;
        Vm.BoardLayoutChanged += OnLayoutChanged;
        Dialogs.Changed += OnDialogChanged;
    }

    public void Dispose()
    {
        Vm.PropertyChanged -= OnChanged;
        Vm.BoardLayoutChanged -= OnLayoutChanged;
        Dialogs.Changed -= OnDialogChanged;
    }

    private void OpenUserGuide() =>
        ((IJSInProcessRuntime)JS).InvokeVoid("open", "docs/14-gui-and-settings", "_blank", "noopener");

    private void OpenDocs() =>
        ((IJSInProcessRuntime)JS).InvokeVoid("open", "docs", "_blank", "noopener");

    private static Task Run(Action action)
    {
        action();
        return Task.CompletedTask;
    }

    private void OnLayoutChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnChanged(object? sender, EventArgs e)
    {
        if (_renderPending) return;

        _renderPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _renderPending = false;
            StateHasChanged();
        });
    }

    private void OnDialogChanged() => InvokeAsync(StateHasChanged);

    private MenuEntry ThemeEntry(string text, string themeName, bool separatorBefore = false) =>
        new(text, new RelayCommand(() => Vm.SetBoardTheme(themeName)), IsChecked: () => Vm.Settings.ThemeName == themeName, Radio: true, SeparatorBefore: separatorBefore);
}
