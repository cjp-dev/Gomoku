@using System.Globalization
@inject MainViewModel ViewModel
@implements IDisposable

<div class="board-container">
    <svg viewBox="0 0 640 640" class="gomoku-board-svg" role="grid" aria-label="Gomoku Board">
        <defs>
            <linearGradient id="wood-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#E8C99B" />
                <stop offset="50%" stop-color="#DCB985" />
                <stop offset="100%" stop-color="#D2A673" />
            </linearGradient>

            <linearGradient id="dark-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#2C3E50" />
                <stop offset="50%" stop-color="#34495E" />
                <stop offset="100%" stop-color="#243342" />
            </linearGradient>

            <linearGradient id="classic-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FBF8EB" />
                <stop offset="50%" stop-color="#F3ECE0" />
                <stop offset="100%" stop-color="#EAE0D0" />
            </linearGradient>

            <radialGradient id="black-stone" cx="32%" cy="32%" r="68%">
                <stop offset="0%" stop-color="#555555" />
                <stop offset="55%" stop-color="#222222" />
                <stop offset="100%" stop-color="#080808" />
            </radialGradient>

            <radialGradient id="white-stone" cx="32%" cy="32%" r="68%">
                <stop offset="0%" stop-color="#FFFFFF" />
                <stop offset="60%" stop-color="#EEEEEE" />
                <stop offset="100%" stop-color="#D0D0D0" />
            </radialGradient>

            <filter id="stone-shadow" x="-20%" y="-20%" width="150%" height="150%">
                <feDropShadow dx="2" dy="3" stdDeviation="3" flood-opacity="0.4" />
            </filter>
        </defs>

        @{
            string theme = ViewModel.Settings.ThemeName;
            (string borderFill, string boardFill, string gridStroke, string coordFill, string starFill) = theme switch
            {
                "Dark" => ("#1A252F", "url(#dark-gradient)", "#546E7A", "#90A4AE", "#B0BEC5"),
                "Classic" => ("#374151", "url(#classic-gradient)", "#4B5563", "#4B5563", "#1F2937"),
                _ => ("#7A5229", "url(#wood-gradient)", "#4A3018", "#5A3818", "#3A2210")
            };

            int cols = ViewModel.Settings.BoardSize.Width;
            int rows = ViewModel.Settings.BoardSize.Height;
            double margin = 36.0;
            double inner = 640.0 - 2 * margin;
            double cellW = inner / (cols - 1);
            double cellH = inner / (rows - 1);
            double stoneR = Math.Min(cellW, cellH) * 0.44;
        }

        <!-- Board Background & Border -->
        <rect x="0" y="0" width="640" height="640" rx="6" fill="@borderFill" />
        <rect x="8" y="8" width="624" height="624" rx="4" fill="@boardFill" />

        <!-- Grid Lines -->
        <g stroke="@gridStroke" stroke-width="1.3">
            @for (int y = 0; y < rows; y++)
            {
                double cy = margin + y * cellH;
                <line x1="@F(margin)" y1="@F(cy)" x2="@F(margin + (cols - 1) * cellW)" y2="@F(cy)"
                      stroke-width="@(y == 0 || y == rows - 1 ? "2.0" : "1.2")" />

                @if (ViewModel.Settings.CoordinatesVisible)
                {
                    @((MarkupString)$"<text x=\"16\" y=\"{F(cy + 4)}\" font-size=\"11\" font-weight=\"600\" fill=\"{coordFill}\" text-anchor=\"middle\">{y + 1}</text>")
                    @((MarkupString)$"<text x=\"624\" y=\"{F(cy + 4)}\" font-size=\"11\" font-weight=\"600\" fill=\"{coordFill}\" text-anchor=\"middle\">{y + 1}</text>")
                }
            }

            @for (int x = 0; x < cols; x++)
            {
                double cx = margin + x * cellW;
                <line x1="@F(cx)" y1="@F(margin)" x2="@F(cx)" y2="@F(margin + (rows - 1) * cellH)"
                      stroke-width="@(x == 0 || x == cols - 1 ? "2.0" : "1.2")" />

                @if (ViewModel.Settings.CoordinatesVisible)
                {
                    char colChar = (char)('A' + x);
                    @((MarkupString)$"<text x=\"{F(cx)}\" y=\"22\" font-size=\"11\" font-weight=\"600\" fill=\"{coordFill}\" text-anchor=\"middle\">{colChar}</text>")
                    @((MarkupString)$"<text x=\"{F(cx)}\" y=\"630\" font-size=\"11\" font-weight=\"600\" fill=\"{coordFill}\" text-anchor=\"middle\">{colChar}</text>")
                }
            }
        </g>

        <!-- Star Points -->
        <g fill="@starFill">
            @foreach (var sp in ViewModel.Settings.BoardSize.GetStarPoints())
            {
                double cx = margin + sp.X * cellW;
                double cy = margin + sp.Y * cellH;
                <circle cx="@F(cx)" cy="@F(cy)" r="4" />
            }
        </g>

        <!-- Interactive Intersections & Stones -->
        @foreach (var cell in ViewModel.Intersections)
        {
            double cx = margin + cell.X * cellW;
            double cy = margin + cell.Y * cellH;

            <g @onclick="() => OnIntersectionClick(cell)"
               @onmouseenter="() => OnCellHover(cell, true)"
               @onmouseleave="() => OnCellHover(cell, false)"
               @onkeydown="e => HandleKeyDown(e, cell)"
               tabindex="0"
               role="gridcell"
               aria-label="@($"Intersection {new Point(cell.X, cell.Y).ToCoordinateString()}{(cell.HasPiece ? $": {cell.Piece}" : "")}")"
               class="board-intersection"
               style="cursor: pointer; outline: none;">

                <!-- Transparent Hit Target -->
                <circle cx="@F(cx)" cy="@F(cy)" r="@F(cellW * 0.48)" fill="transparent" class="hit-target" />

                <!-- Renju Forbidden Move Marker -->
                @if (cell.ShowForbiddenMarker)
                {
                    <line x1="@F(cx - 5)" y1="@F(cy - 5)" x2="@F(cx + 5)" y2="@F(cy + 5)" stroke="#D32F2F" stroke-width="2.4" stroke-linecap="round" />
                    <line x1="@F(cx + 5)" y1="@F(cy - 5)" x2="@F(cx - 5)" y2="@F(cy + 5)" stroke="#D32F2F" stroke-width="2.4" stroke-linecap="round" />
                }

                <!-- Ghost Preview Stone -->
                @if ((cell.ShowBlackGhost || cell.ShowWhiteGhost) && ViewModel.CanHoverMove && ViewModel.Settings.GhostStoneEnabled)
                {
                    <circle cx="@F(cx)" cy="@F(cy)" r="@F(stoneR)"
                            fill="@(cell.ShowBlackGhost ? "url(#black-stone)" : "url(#white-stone)")"
                            opacity="0.45" />
                }

                <!-- Placed Stone -->
                @if (cell.HasPiece)
                {
                    <circle cx="@F(cx)" cy="@F(cy)" r="@F(stoneR)"
                            fill="@(cell.IsBlack ? "url(#black-stone)" : "url(#white-stone)")"
                            filter="url(#stone-shadow)" />

                    <!-- Last Move Marker -->
                    @if (cell.IsLastMove && ViewModel.Settings.LastMoveHighlightEnabled)
                    {
                        <circle cx="@F(cx)" cy="@F(cy)" r="4" fill="#E74C3C" />
                    }

                    <!-- Winning Line Gold Ring -->
                    @if (cell.IsWinningLine && ViewModel.Settings.WinLineHighlightEnabled)
                    {
                        <circle cx="@F(cx)" cy="@F(cy)" r="@F(stoneR + 2)" stroke="#F1C40F" stroke-width="3" fill="none" />
                    }
                }
            </g>
        }
    </svg>
</div>

@code {
    private static string F(double val) => val.ToString("0.##", CultureInfo.InvariantCulture);
    private bool _renderPending;

    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        ViewModel.BoardLayoutChanged += OnBoardLayoutChanged;
    }

    private void OnViewModelPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(ViewModel.BlackRemainingTime)
            or nameof(ViewModel.WhiteRemainingTime)
            or nameof(ViewModel.BlackTimeFormatted)
            or nameof(ViewModel.WhiteTimeFormatted)
            or nameof(ViewModel.ClockText)
            or nameof(ViewModel.StatusText)
            or nameof(ViewModel.MoveHistoryText)
            or nameof(ViewModel.IsThinking))
        {
            return;
        }

        QueueRender();
    }

    private void OnBoardLayoutChanged() => QueueRender();

    private void QueueRender()
    {
        if (_renderPending) return;
        _renderPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _renderPending = false;
            StateHasChanged();
        });
    }

    private void OnIntersectionClick(IntersectionViewModel cell)
    {
        ViewModel.OnIntersectionClicked(cell);
        QueueRender();
    }

    private void HandleKeyDown(KeyboardEventArgs e, IntersectionViewModel cell)
    {
        if (e.Key is "Enter" or " ")
        {
            OnIntersectionClick(cell);
        }
    }

    private void OnCellHover(IntersectionViewModel cell, bool isHovered)
    {
        if (ViewModel.CanHoverMove && ViewModel.Settings.GhostStoneEnabled)
        {
            cell.IsHovered = isHovered;
        }
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
        ViewModel.BoardLayoutChanged -= OnBoardLayoutChanged;
    }
}
