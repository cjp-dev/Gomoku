@using Gomoku.Core.AI
@using Gomoku.Core.Models
@using Gomoku.Web.Services
@implements IDisposable
@inject BrowserDialogService Dialogs

@if (Dialogs.Current is { } dialog)
{
    <div class="dialog-backdrop">
        <div class="dialog @(dialog.Picture is null ? null : "dialog-with-picture")"
             role="dialog"
             aria-modal="true"
             aria-labelledby="dialog-title"
             @onkeydown="e => OnKeyDown(dialog, e)">

            <h2 id="dialog-title">@dialog.Title</h2>

            @if (dialog.Picture is not null)
            {
                <figure class="dialog-picture">
                    <img src="@dialog.Picture" alt="@dialog.PictureCaption" />
                    <figcaption>@dialog.PictureCaption</figcaption>
                </figure>
            }

            <div class="dialog-body">
                @if (dialog.Heading is not null)
                {
                    <p class="dialog-heading"><strong>@dialog.Heading</strong></p>
                }
                @if (dialog.Message is not null)
                {
                    <p class="dialog-message">@dialog.Message</p>
                }
                @foreach (string paragraph in dialog.Paragraphs)
                {
                    <p>@paragraph</p>
                }
            </div>

            @if (dialog.Settings is { } settings)
            {
                <fieldset class="settings" style="margin-bottom: 1rem;">
                    <legend>Board Size &amp; Rules Variant</legend>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                        <div>
                            <span style="font-size: 0.8rem; font-weight: 700; color: #64748B;">BOARD SIZE</span>
                            <label><input type="radio" name="boardSize" checked="@(settings.SelectedBoardSize == BoardSize.Size15x15)" @onchange="() => settings.SelectedBoardSize = BoardSize.Size15x15" /> 15 × 15 (Standard)</label>
                            <label><input type="radio" name="boardSize" checked="@(settings.SelectedBoardSize == BoardSize.Size19x19)" @onchange="() => settings.SelectedBoardSize = BoardSize.Size19x19" /> 19 × 19 (Go board)</label>
                            <label><input type="radio" name="boardSize" checked="@(settings.SelectedBoardSize == BoardSize.Size20x20)" @onchange="() => settings.SelectedBoardSize = BoardSize.Size20x20" /> 20 × 20 (Freestyle)</label>
                        </div>
                        <div>
                            <span style="font-size: 0.8rem; font-weight: 700; color: #64748B;">RULES VARIANT</span>
                            <label><input type="radio" name="variant" checked="@(settings.SelectedVariant == GomokuVariant.Freestyle)" @onchange="() => settings.SelectedVariant = GomokuVariant.Freestyle" /> Freestyle (5+ wins)</label>
                            <label><input type="radio" name="variant" checked="@(settings.SelectedVariant == GomokuVariant.Exact5)" @onchange="() => settings.SelectedVariant = GomokuVariant.Exact5" /> Standard (Exact 5)</label>
                            <label><input type="radio" name="variant" checked="@(settings.SelectedVariant == GomokuVariant.Renju)" @onchange="() => settings.SelectedVariant = GomokuVariant.Renju" /> Renju (Forbidden 3x3/4x4)</label>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="settings" style="margin-bottom: 1rem;">
                    <legend>Board Theme</legend>
                    <div style="display: flex; gap: 1.5rem;">
                        @foreach (string theme in settings.AvailableThemes)
                        {
                            <label>
                                <input type="radio" name="boardTheme" checked="@(settings.ThemeName == theme)" @onchange="() => settings.ThemeName = theme" />
                                @theme
                            </label>
                        }
                    </div>
                </fieldset>

                <fieldset class="settings" style="margin-bottom: 1rem;">
                    <legend>AI Engine</legend>
                    <div style="display: flex; gap: 1.5rem;">
                        <label><input type="radio" name="engine" checked="@(settings.SelectedAiEngine == AiEngineType.Carbon)" @onchange="() => settings.SelectedAiEngine = AiEngineType.Carbon" /> Carbon AI (Advanced)</label>
                        <label><input type="radio" name="engine" checked="@(settings.SelectedAiEngine == AiEngineType.Simple)" @onchange="() => settings.SelectedAiEngine = AiEngineType.Simple" /> Simple AI</label>
                    </div>
                </fieldset>

                @if (settings.IsCarbonEngine)
                {
                    <fieldset class="settings" style="margin-bottom: 1rem;">
                        <legend>Computer Thinking Limits</legend>
                        <label><input type="radio" name="timeMode" checked="@(settings.SelectedTimeControl == TimeControlMode.FixedDepth)" @onchange="() => settings.SelectedTimeControl = TimeControlMode.FixedDepth" /> Fixed depth</label>
                        <input type="range" min="1" max="14" aria-label="Depth" disabled="@(settings.SelectedTimeControl != TimeControlMode.FixedDepth)"
                               @bind="settings.SearchDepth" @bind:event="oninput" />
                        <span>@settings.SearchDepth plies</span>

                        <label><input type="radio" name="timeMode" checked="@(settings.SelectedTimeControl == TimeControlMode.TimePerMove)" @onchange="() => settings.SelectedTimeControl = TimeControlMode.TimePerMove" /> Time per move</label>
                        <input type="range" min="1" max="20" aria-label="Seconds per move" disabled="@(settings.SelectedTimeControl != TimeControlMode.TimePerMove)"
                               @bind="settings.MoveTimeSeconds" @bind:event="oninput" />
                        <span>@settings.MoveTimeSeconds seconds</span>

                        <label><input type="radio" name="timeMode" checked="@(settings.SelectedTimeControl == TimeControlMode.TimePerGame)" @onchange="() => settings.SelectedTimeControl = TimeControlMode.TimePerGame" /> Time per game</label>
                        <input type="range" min="1" max="30" aria-label="Minutes per game" disabled="@(settings.SelectedTimeControl != TimeControlMode.TimePerGame)"
                               @bind="settings.GameTimeMinutes" @bind:event="oninput" />
                        <span>@settings.GameTimeMinutes minutes</span>
                    </fieldset>

                    <fieldset class="settings">
                        <legend>Carbon Opening Book &amp; Transposition Table</legend>
                        <label style="font-weight: normal;">
                            <input type="checkbox" @bind="settings.UseOpeningBook" />
                            Carbon Opening Book (67 symmetry patterns)
                        </label>
                        <div style="margin-top: 0.75rem;">
                            <label style="margin-top: 0;">Transposition Table Capacity:</label>
                            <select class="dialog-text" style="margin: 0.25rem 0;" @bind="settings.TranspositionTableEntries">
                                <option value="65536">65,536 entries (1 MB)</option>
                                <option value="262144">262,144 entries (4 MB)</option>
                                <option value="1048576">1,048,576 entries (16 MB) - Default</option>
                                <option value="4194304">4,194,304 entries (64 MB)</option>
                                <option value="16777216">16,777,216 entries (256 MB)</option>
                            </select>
                        </div>
                    </fieldset>
                }
            }

            <div class="dialog-buttons">
                @for (int i = 0; i < dialog.Buttons.Count; i++)
                {
                    int button = i;
                    if (button == 0)
                    {
                        <button class="default" @ref="_defaultButton" @onclick="() => Dialogs.Close(dialog, button)">@dialog.Buttons[button]</button>
                    }
                    else
                    {
                        <button @onclick="() => Dialogs.Close(dialog, button)">@dialog.Buttons[button]</button>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _defaultButton;
    private DialogRequest? _focused;

    protected override void OnInitialized() => Dialogs.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Dialogs.Current is { } dialog && dialog != _focused)
        {
            _focused = dialog;
            try
            {
                await _defaultButton.FocusAsync();
            }
            catch
            {
            }
        }
    }

    public void Dispose() => Dialogs.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnKeyDown(DialogRequest dialog, KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Dialogs.Close(dialog, dialog.Buttons.Count - 1);
        }
    }
}
